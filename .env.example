NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Security integration tests only; never use NEXT_PUBLIC_ for these:
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Default: drive (visible IdeaDock folder, drive.file). Legacy: appDataFolder.
NEXT_PUBLIC_GOOGLE_DRIVE_SPACE=
# Default: drive. Set legacy only for rollback to the preserved Supabase client.
NEXT_PUBLIC_STORAGE_BACKEND=
# Default: token (GitHub Pages, Google popup). server: Cloudflare Pages build
# with /api/auth sessions; set by `npm run build:cloudflare`, see docs/CLOUDFLARE.md.
NEXT_PUBLIC_AUTH_MODE=
